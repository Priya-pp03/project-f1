# Copy to .env and fill in your key for embed_chunks.py to pick it up.
#
# OpenAI keys look like:      sk-proj-...
# OpenRouter keys look like:  sk-or-v1-...
#
# The endpoint is inferred from the key prefix, so an sk-or-v1-... key is
# automatically sent to https://openrouter.ai/api/v1. Override either value
# below if you use a different OpenAI-compatible gateway.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# EMBED_MODEL=openai/text-embedding-3-small
